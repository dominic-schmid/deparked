// The admin Worker. Users never deploy it with wrangler: the installer uploads the release through the API
// and binds the real database. This config is for local dev, the build and `wrangler deploy --dry-run`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deparked-admin",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deparked"
    }
  ],
  // Offer emails. No fixed destination: the Worker may send to any verified Email Routing address of the account.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  // Everything the Worker reads besides its bindings (README "Environment contract"). Local dev loads only the
  // names listed here from .dev.vars; a missing one is a warning. The installer sets the real values, and one
  // TURNSTILE_SECRET_<n> per widget.
  "secrets": {
    "required": ["SESSION_KEY", "CF_API_TOKEN", "CF_ACCOUNT_ID", "TURNSTILE_SECRET_1"]
  },
  // Invocation logs record every request URL. The setup link carries its one-time secret in the query, so they
  // stay off; our own console logs are still collected.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
