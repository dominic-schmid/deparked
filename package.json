{
  "name": "deparked",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p apps/install && tsc --noEmit -p apps/install/src/ui && tsc --noEmit -p e2e && tsc --noEmit -p tests/lander",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run && node --test scripts/hooks/guard.test.ts",
    "build:install": "node scripts/build-install.ts",
    "check:install-fresh": "pnpm build:install && test -z \"$(git status --porcelain -- apps/install/dist apps/install/public)\"",
    "dry-run": "pnpm --filter @deparked/admin build && pnpm -r deploy:dry-run",
    "build:templates": "pnpm --filter @deparked/templates build",
    "check:templates-fresh": "pnpm build:templates && test -z \"$(git status --porcelain -- packages/templates/src apps/sites/public/catalog)\"",
    "test:layout": "playwright test --config tests/lander",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:real": "playwright test --config e2e/playwright.real.config.ts --pass-with-no-tests",
    "build:release": "pnpm --filter @deparked/admin build && node scripts/build-release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@cloudflare/workers-types": "5.20261110.1",
    "@deparked/cf": "workspace:*",
    "@deparked/config": "workspace:*",
    "@deparked/db": "workspace:*",
    "@deparked/templates": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "^4.3.5",
    "@tanstack/intent": "0.5.6",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.160.1"
  },
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
