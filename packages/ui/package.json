{
  "name": "@deparked/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./src/styles/globals.css",
    "./lib/*": "./src/lib/*.ts",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./arc/*": "./src/arc/*.ts",
    "./*": "./src/components/ui/*.tsx"
  },
  "imports": {
    "#arc/*": {
      "types": "./types/arc/*.d.ts",
      "default": "./src/components/arc/*.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.arc-types.json && tsc --noEmit && tsc --noEmit -p tsconfig.arc.json",
    "arc-types": "tsc -p tsconfig.arc-types.json",
    "test": "vitest run --passWithNoTests",
    "fonts": "node scripts/fonts.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "subset-font": "2.9.0",
    "tailwindcss": "^4.3.5"
  }
}
