d=true] .send-text{animation:1.1s ease-in-out infinite wait}.shake{animation:.4s cubic-bezier(.36,.07,.19,.97) shake}@keyframes wait{50%{opacity:.35}}@keyframes shake{20%{translate:-6px}40%{translate:5px}60%{translate:-3px}80%{translate:2px}}@media (prefers-reduced-motion:reduce){*,:before,:after{transition:none!important;animation:none!important}}.page{--action:var(--accent,var(--ink));--on-action:var(--accent-contrast,var(--paper));--mark:var(--accent-mark,var(--red));min-height:100svh;padding:max(calc(var(--edge) * .75), env(safe-area-inset-top)) max(var(--edge), env(safe-area-inset-right)) max(var(--edge), env(safe-area-inset-bottom)) max(var(--edge), env(safe-area-inset-left));caret-color:var(--mark);grid-template-rows:auto 1fr auto;grid-template-columns:minmax(0,1fr);display:grid;container-type:inline-size}@media (prefers-color-scheme:dark){.page{--mark:var(--accent-mark-dark,var(--red))}}.folio:after,.masthead:after,.row:before{content:"";transform-origin:0;animation:draw .42s var(--ease-swift) both;position:absolute;inset-inline:0}.folio{letter-spacing:.1em;justify-content:space-between;gap:16px;padding-bottom:14px;font-size:clamp(17px,.85vw,21px);font-variant-caps:all-small-caps;display:flex;position:relative}.folio:after{border-top:3px solid var(--ink);border-bottom:1px solid var(--ink);height:7px;bottom:-7px}.masthead{font-family:Newsreader, "Newsreader Fallback", var(--font-serif);text-align:center;letter-spacing:-.03em;font-weight:400;line-height:.92;font-size:min(var(--fit), 400px, 36svh);white-space:nowrap;text-wrap:balance;align-content:center;margin-top:7px;padding:.2em 0 .16em;display:grid;position:relative}.masthead:after{background:var(--rule);height:1px;animation-delay:60ms;bottom:0}.masthead[data-lines]{font-size:min(var(--fit), 400px, 30svh / var(--lines));line-height:1}.masthead[data-lines] span{display:block}.masthead[data-lines=auto]{white-space:normal;overflow-wrap:anywhere}.column{grid-template-columns:minmax(0,1fr);gap:14px;padding-top:clamp(28px,7svh,96px);display:grid}.label{letter-spacing:.1em;color:var(--mark);font-size:clamp(17px,.85vw,21px);font-variant-caps:all-small-caps}@container (min-width:720px){.column{grid-template-columns:minmax(8rem,2fr) minmax(0,9fr);gap:0}.label{border-inline-end:1px solid var(--hair);padding-top:.5em;padding-inline-end:24px}.offer{padding-inline-start:clamp(24px,3vw,56px)}}.say{letter-spacing:-.012em;text-wrap:pretty;overflow-wrap:break-word;max-width:26em;font-size:clamp(26px,3.1vw,62px);line-height:1.3}.offer[data-long] .say{font-size:clamp(22px,2.3vw,38px)}.slot input{font:italic 400 1em / 1 var(--font-serif);color:var(--ink);border:0;border-bottom:1px solid var(--ink);field-sizing:content;touch-action:manipulation;background:0 0;border-radius:0;outline:none;padding:0 .12em .04em;transition-property:border-color,background-color;transition-duration:.15s;transition-timing-function:ease-out}.slot input::placeholder{color:var(--muted);opacity:1}.slot input:focus{border-bottom:2px solid var(--mark);background:var(--field)}.slot input[aria-invalid=true]{border-bottom:2px dashed var(--red)}.slot input[name=amount]{margin-inline-start:.1em}.row{flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px 32px;margin-top:clamp(24px,4svh,44px);padding-top:18px;display:flex;position:relative}.row:before{background:var(--hair);height:1px;animation-delay:.16s;top:0}.fine{color:var(--muted);overflow-wrap:break-word;flex:18em;min-width:0;margin-inline-end:auto;font-size:clamp(16px,.8vw,20px);font-style:italic;line-height:1.45}.fine a{color:inherit;text-underline-offset:.2em;text-decoration-thickness:1px;transition:color .15s ease-out}.fine a:focus-visible{outline:2px solid var(--mark);outline-offset:3px}.send{white-space:nowrap;cursor:pointer;min-height:clamp(52px,2.6vw,64px);font:600 clamp(13px, .65vw, 16px) / 1 var(--font-sans);letter-spacing:.14em;text-transform:uppercase;color:var(--on-action);background:var(--action);touch-action:manipulation;border:0;border-radius:0;flex-shrink:0;align-items:center;gap:14px;margin-inline-start:auto;padding:0 1.7em 0 2em;transition-property:scale,box-shadow;transition-duration:.15s;transition-timing-function:ease-out;display:inline-flex}.send:active{scale:.96}.send:focus-visible{outline:2px solid var(--mark);outline-offset:3px}.send svg{transition:translate .2s var(--ease-swift)}@media (hover:hover) and (pointer:fine){.slot input:hover:not(:focus,[aria-invalid=true]){background:var(--field)}.fine a:hover{color:var(--ink)}.send:hover{box-shadow:inset 0 -3px 0 var(--mark)}.send:hover svg{translate:3px}}.nojs{border-inline-start:2px solid var(--mark);padding-inline-start:14px;font-size:clamp(16px,.85vw,20px);font-style:italic;line-height:1.4}.tag{background:var(--red);color:var(--paper);animation:pop .28s var(--ease-swift) both;overflow-wrap:anywhere;flex:0 auto;margin-inline-end:auto;padding:10px 16px 11px;font-size:17px;line-height:1.3}.sent h2{letter-spacing:-.02em;text-wrap:balance;overflow-wrap:anywhere;max-width:20em;font-size:clamp(32px,4.2vw,68px);font-weight:400;line-height:1.1}.sent p{color:var(--muted);overflow-wrap:anywhere;margin-top:14px;font-size:18px;font-style:italic}[data-enter]{animation:enter .36s var(--ease-swift) both;animation-delay:calc(var(--i,0) * 60ms)}.masthead[data-enter]{animation-name:settle}@media (orientation:landscape) and (max-height:540px){.masthead{font-size:min(var(--fit), 22svh)}.masthead[data-lines]{font-size:min(var(--fit), 28svh / var(--lines))}.column{padding-top:clamp(14px,4svh,28px)}.say{font-size:clamp(21px,5.4svh,32px)}.row{margin-top:clamp(12px,3svh,24px);padding-top:12px}.send{min-height:44px}}}@layer utilities{.visible{visibility:visible}.sr-only{clip-path:inset(50%);white-space:nowrap;border-width:0;width:1px;height:1px;margin:-1px;padding:0;position:absolute;overflow:hidden}.fixed{position:fixed}.container{width:100%}@media (min-width:40rem){.container{max-width:40rem}}@media (min-width:48rem){.container{max-width:48rem}}@media (min-width:64rem){.container{max-width:64rem}}@media (min-width:80rem){.container{max-width:80rem}}@media (min-width:96rem){.container{max-width:96rem}}.hidden{display:none}.grow{flex-grow:1}}@font-face{font-family:Newsreader Fallback;src:local(Times New Roman),local(TimesNewRomanPSMT),local(Liberation Serif),local(LiberationSerif),local(Tinos),local(Times);size-adjust:104%;font-display:swap}@keyframes draw{0%{transform:scaleX(0)}}@keyframes pop{0%{opacity:0;translate:0 -6px}}@keyframes enter{0%{filter:blur(3px);translate:0 10px}}@keyframes settle{0%{filter:blur(3px);translate:0 -8px;scale:1.015}}</style><script type="module" src="/catalog/islands/editorial.9f2e2adb1c3d.js" fetchPriority="low"></script><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebPage","url":"https://example.com/","name":"example.com is for sale","description":"The domain example.com is for sale. Send the owner an offer.","inLanguage":"en","about":{"@type":"Thing","name":"example.com","description":"The domain name example.com, for sale by its owner."}}</script></head><body><div class="page"><header class="folio" data-enter=""><span>For sale</span><span>Offers by email</span></header><h1 class="masthead" dir="auto" translate="no" data-enter="" style="--i:1;--fit:17.39cqi;--lines:1">example.com</h1><section class="column" aria-labelledby="the-offer" data-enter="" style="--i:2"><p class="label" id="the-offer">The offer</p><div class="offer" data-island="offer-form" data-props="{&quot;endpoint&quot;:&quot;/api/offer&quot;,&quot;sitekey&quot;:&quot;1x00000000000000000000AA&quot;,&quot;currency&quot;:&quot;EUR&quot;,&quot;minOffer&quot;:1000,&quot;sentence&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;I&#x27;d like to buy example.com for &quot;},{&quot;type&quot;:&quot;slot&quot;,&quot;slot&quot;:&quot;amount&quot;},{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;. My name is &quot;},{&quot;type&quot;:&quot;slot&quot;,&quot;slot&quot;:&quot;name&quot;},{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot; and you can reach me at &quot;},{&quot;type&quot;:&quot;slot&quot;,&quot;slot&quot;:&quot;email&quot;},{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;.&quot;}],&quot;finePrint&quot;:&quot;The owner reads every offer and replies by email. Payment through Escrow.com.&quot;,&quot;turnstileTheme&quot;:&quot;auto&quot;}"><form action="/api/offer" method="post"><p class="say"><span dir="auto">I&#x27;d like to buy example.com for </span><span class="slot"><label class="hit" for="amount" aria-hidden="true"></label>€<label class="sr-only" for="amount">Offer in euros</label><input inputMode="numeric" autoComplete="off" placeholder="your price" pattern="[0-9][0-9.,&#x27; ]*" id="amount" required="" size="10" enterKeyHint="next" aria-describedby="e-amount" name="amount"/><span class="tail">.</span><span class="sr-only" id="e-amount"></span></span><span dir="auto"> My name is </span><span class="slot"><label class="hit" for="name" aria-hidden="true"></label><label class="sr-only" for="name">Your name</label><input autoComplete="name" autoCapitalize="words" maxLength="100" placeholder="your name" spellCheck="false" id="name" required="" size="9" enterKeyHint="next" aria-describedby="e-name" name="name"/><span class="sr-only" id="e-name"></span></span><span dir="auto"> and you can reach me at </span><span class="slot"><label class="hit" for="email" aria-hidden="true"></label><label class="sr-only" for="email">Your email</label><input type="email" autoComplete="email" maxLength="200" placeholder="you@company.com" spellCheck="false" id="email" required="" size="15" enterKeyHint="send" aria-describedby="e-email" name="email"/><span class="tail">.</span><span class="sr-only" id="e-email"></span></span></p><input class="hp" tabindex="-1" autoComplete="off" aria-hidden="true" name="website"/><div class="row"><p class="fine" dir="auto">The owner reads every offer and replies by email. Payment through Escrow.com.</p><p class="tag" id="offer-error-amount">Offers start at €1,000. Raise yours to send it</p><p class="tag" id="offer-error-name">Add your name</p><p class="tag" id="offer-error-email">Add an email we can reply to</p><p class="tag" id="offer-error-check">Offers need JavaScript for the spam check. Turn it on and send again</p><p class="tag" id="offer-error-rate">Too many offers from here. Try again later</p><p class="tag" id="offer-error-failed">That didn&#x27;t go through. Try again in a minute</p><p class="tag" id="e-form" role="alert"></p><div class="cf-turnstile"></div><button class="send" type="submit"><span class="send-text" data-alt="Sending…"><span>Send offer</span></span><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0-4-4m4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><span class="sr-only" role="status"></span><noscript><p class="nojs" dir="auto">Offers need JavaScript for the spam check. <!-- -->Turn it on and reload this page to send yours.</p></noscript></div></form><div class="sent" id="offer-sent"><h2>Thanks. Your offer is with the owner.</h2><p>Next, the owner reads it. Any reply goes to the email you gave.</p></div><div class="sent" hidden="" tabindex="-1"></div></div></section></div></body></html>"
`;

