span,.send .send-text:after{grid-area:1/1}.send .send-text:after{content:attr(data-alt);visibility:hidden}.send[aria-disabled=true]{cursor:progress}.send[aria-disabled=true] .send-text{animation:1.1s ease-in-out infinite wait}.shake{animation:.4s cubic-bezier(.36,.07,.19,.97) shake}@keyframes wait{50%{opacity:.35}}@keyframes shake{20%{translate:-6px}40%{translate:5px}60%{translate:-3px}80%{translate:2px}}@media (prefers-reduced-motion:reduce){*,:before,:after{transition:none!important;animation:none!important}}.photo{background:linear-gradient(178deg,#5f86b3 0%,#8faccb 40%,#d9cdb5 72%,#6c7f45 100%);height:100svh;position:sticky;top:0;overflow:hidden}.photo picture,.photo img{width:100%;height:100%;display:block}.photo img{object-fit:cover;animation:settle 1.2s var(--ease-swift) both;background-repeat:no-repeat;background-size:cover}.panel{min-width:0;min-height:100svh;padding:max(var(--edge), env(safe-area-inset-top)) max(var(--edge), env(safe-area-inset-right)) max(var(--edge), env(safe-area-inset-bottom)) var(--edge);grid-template-rows:auto 1fr auto;grid-template-columns:minmax(0,1fr);display:grid;container-type:inline-size}.bar{letter-spacing:.1em;text-transform:uppercase;color:var(--soft);flex-wrap:wrap;justify-content:space-between;gap:4px 16px;font-size:clamp(12px,.75vw,16px);font-weight:600;display:flex}.mark{font:italic 400 min(var(--fit), 260px, 30svh) / .95 Newsreader, "Newsreader Italic Fallback", var(--font-serif);letter-spacing:-.015em;white-space:nowrap;align-self:end;padding-top:clamp(32px,8svh,96px);padding-bottom:.12em}.mark[data-lines]{font-size:min(var(--fit), 260px, 40svh / var(--lines));line-height:1.02}.mark[data-lines] span{display:block}.mark[data-lines=auto]{white-space:normal;overflow-wrap:anywhere}.offer{border-top:1px solid var(--line);margin-top:clamp(20px,4svh,40px);padding-top:clamp(20px,3svh,32px)}.say{letter-spacing:-.005em;text-wrap:pretty;overflow-wrap:break-word;max-width:30em;font-size:clamp(19px,1.75vw,44px);line-height:1.5}.slot input{font:italic 400 1.12em / 1.2 var(--font-serif);color:var(--on);border:0;border-bottom:1.5px solid var(--line);field-sizing:content;touch-action:manipulation;background:0 0;border-radius:0;outline:none;padding:0 .1em .02em;transition:border-color .15s ease-out}.slot input::placeholder{color:var(--soft);opacity:1}.slot input:focus{border-color:var(--on)}.slot input:focus-visible{outline:2px solid var(--on);outline-offset:3px}.slot input[aria-invalid=true]{border-bottom:2px solid var(--invalid)}.slot input[name=amount]{margin-left:.3em}.row{flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px 24px;margin-top:clamp(24px,4svh,40px);display:flex}.fine{color:var(--soft);overflow-wrap:break-word;flex:14em;min-width:0;margin-right:auto;font-size:clamp(13px,.8vw,17px);line-height:1.5}.fine a{color:inherit;text-underline-offset:.2em;transition:color .15s ease-out}.fine a:focus-visible{outline:2px solid var(--on);outline-offset:3px;border-radius:2px}.send{white-space:nowrap;cursor:pointer;min-height:clamp(52px,3.2vw,72px);font:600 clamp(15px, .9vw, 20px) / 1 var(--font-sans);letter-spacing:.01em;color:var(--panel);background:var(--on);touch-action:manipulation;border:0;border-radius:4px;flex-shrink:0;align-items:center;gap:12px;margin-left:auto;padding:0 clamp(22px,1.4vw,32px);transition-property:scale,opacity;transition-duration:.15s;transition-timing-function:ease-out;display:inline-flex}.send:active{scale:.97}.send:focus-visible{outline:2px solid var(--on);outline-offset:3px}.send svg{transition:translate .2s var(--ease-swift)}@media (hover:hover){.slot input:hover:not(:focus,[aria-invalid=true]){border-color:var(--soft)}.fine a:hover{color:var(--on)}.send:hover{opacity:.9}.send:hover svg{translate:3px}}.nojs{border:1px solid var(--line);border-radius:4px;padding:12px 16px;font-size:clamp(14px,.85vw,17px);line-height:1.45}.tag{color:#8c2109;overflow-wrap:anywhere;min-width:0;animation:pop .24s var(--ease-swift) both;background:#fbe3d9;border-radius:4px;flex:0 auto;align-items:center;gap:10px;margin-right:auto;padding:11px 16px;font-size:15px;font-weight:600;display:inline-flex}.tag:before{content:"";background:currentColor;border-radius:50%;flex-shrink:0;width:7px;height:7px}.sent h2{font:italic 400 clamp(30px, 3.4vw, 56px) / 1.1 var(--font-serif);letter-spacing:-.01em;text-wrap:balance;overflow-wrap:anywhere}.sent p{color:var(--soft);overflow-wrap:anywhere;margin-top:12px;font-size:15px}[data-enter]{animation:enter .38s var(--ease-swift) both;animation-delay:calc(var(--i,0) * 60ms + 80ms)}@media (orientation:portrait){body{grid-template-rows:auto auto;grid-template-columns:minmax(0,1fr)}.photo{height:36svh;position:relative}.panel{min-height:64svh;padding-top:clamp(20px,4vw,48px);padding-left:max(var(--edge), env(safe-area-inset-left))}.mark{font-size:min(var(--fit), 260px, 22svh);padding-top:clamp(24px,5svh,64px)}.mark[data-lines]{font-size:min(var(--fit), 260px, 30svh / var(--lines))}}@media (orientation:landscape) and (max-height:540px){.mark{font-size:min(var(--fit), 22svh);padding-top:16px}.mark[data-lines]{font-size:min(var(--fit), 28svh / var(--lines))}.say{font-size:clamp(16px,4.6svh,20px)}.send{min-height:44px}}}@layer utilities{.visible{visibility:visible}.sr-only{clip-path:inset(50%);white-space:nowrap;border-width:0;width:1px;height:1px;margin:-1px;padding:0;position:absolute;overflow:hidden}.fixed{position:fixed}.container{width:100%}@media (min-width:40rem){.container{max-width:40rem}}@media (min-width:48rem){.container{max-width:48rem}}@media (min-width:64rem){.container{max-width:64rem}}@media (min-width:80rem){.container{max-width:80rem}}@media (min-width:96rem){.container{max-width:96rem}}.hidden{display:none}.grow{flex-grow:1}.italic{font-style:italic}}@font-face{font-family:Newsreader Italic Fallback;src:local(Times New Roman Italic),local(TimesNewRomanPS-ItalicMT),local(Liberation Serif Italic),local(LiberationSerif-Italic),local(Tinos Italic),local(Times Italic);size-adjust:98%;font-display:swap;font-style:italic}@keyframes settle{0%{scale:1.04}}@keyframes pop{0%{opacity:0;translate:0 -6px;scale:.97}}@keyframes enter{0%{translate:0 12px}}</style><script type="module" src="/catalog/islands/split.9f2e2adb1c3d.js" fetchPriority="low"></script><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebPage","url":"https://example.com/","name":"example.com is for sale","description":"The domain example.com is for sale. Send the owner an offer.","inLanguage":"en","about":{"@type":"Thing","name":"example.com","description":"The domain name example.com, for sale by its owner."}}</script></head><body><div class="photo" aria-hidden="true"><picture><source type="image/avif" srcSet="/catalog/backgrounds/sky-640.9ad734854a39.avif 640w, /catalog/backgrounds/sky-960.af72fb594334.avif 960w, /catalog/backgrounds/sky-1280.aed9989ee826.avif 1280w, /catalog/backgrounds/sky-1672.9bc9d8dac11f.avif 1672w" sizes="(orientation: portrait) and (max-aspect-ratio: 1/100) 1vh, (orientation: portrait) 100vw, (max-aspect-ratio: 355/100) 178vh, 50vw"/><img src="/catalog/backgrounds/sky-1672.47efaf7f1e4b.webp" srcSet="/catalog/backgrounds/sky-640.86246fb06899.webp 640w, /catalog/backgrounds/sky-960.0fa20fd87d6c.webp 960w, /catalog/backgrounds/sky-1280.059ff8c474a1.webp 1280w, /catalog/backgrounds/sky-1672.47efaf7f1e4b.webp 1672w" sizes="(orientation: portrait) and (max-aspect-ratio: 1/100) 1vh, (orientation: portrait) 100vw, (max-aspect-ratio: 355/100) 178vh, 50vw" width="1672" height="941" alt="" fetchPriority="high" decoding="async" style="object-position:center 30%;background-image:url(data:image/webp;base64,UklGRmgAAABXRUJQVlA4IFwAAADwAwCdASoYAA0APu1iqk4ppaQiMAgBMB2JagCdMoABO1QDQFEgGy1QAH0LIpVaisMJwMaz6bxqUEd5IlF6YRsl/Jb5nEBoKWT5io9sA90MMjVkGs3bUSPwRiAAAA==);background-position:center 30%"/></picture></div><main class="panel" data-tone="dark"><header class="bar" data-enter=""><span>For sale</span><span>Offers by email</span></header><h1 class="mark" dir="auto" translate="no" data-enter="" style="--i:1;--fit:18.99cqi;--lines:1">example.com</h1><div class="offer" data-enter="" style="--i:2" data-island="offer-form" data-props="{&quot;endpoint&quot;:&quot;/api/offer&quot;,&quot;sitekey&quot;:&quot;1x00000000000000000000AA&quot;,&quot;currency&quot;:&quot;EUR&quot;,&quot;minOffer&quot;:1000,&quot;sentence&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;I&#x27;d like to buy example.com for &quot;},{&quot;type&quot;:&quot;slot&quot;,&quot;slot&quot;:&quot;amount&quot;},{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;. My name is &quot;},{&quot;type&quot;:&quot;slot&quot;,&quot;slot&quot;:&quot;name&quot;},{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot; and you can reach me at &quot;},{&quot;type&quot;:&quot;slot&quot;,&quot;slot&quot;:&quot;email&quot;},{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;.&quot;}],&quot;finePrint&quot;:&quot;The owner reads every offer and replies by email. Payment through Escrow.com.&quot;,&quot;turnstileTheme&quot;:&quot;dark&quot;}"><form action="/api/offer" method="post"><p class="say"><span dir="auto">I&#x27;d like to buy example.com for </span><span class="slot"><label class="hit" for="amount" aria-hidden="true"></label>€<label class="sr-only" for="amount">Offer in euros</label><input inputMode="numeric" autoComplete="off" placeholder="your price" pattern="[0-9][0-9.,&#x27; ]*" id="amount" required="" size="10" enterKeyHint="next" aria-describedby="e-amount" name="amount"/><span class="tail">.</span><span class="sr-only" id="e-amount"></span></span><span dir="auto"> My name is </span><span class="slot"><label class="hit" for="name" aria-hidden="true"></label><label class="sr-only" for="name">Your name</label><input autoComplete="name" autoCapitalize="words" maxLength="100" placeholder="your name" spellCheck="false" id="name" required="" size="9" enterKeyHint="next" aria-describedby="e-name" name="name"/><span class="sr-only" id="e-name"></span></span><span dir="auto"> and you can reach me at </span><span class="slot"><label class="hit" for="email" aria-hidden="true"></label><label class="sr-only" for="email">Your email</label><input type="email" autoComplete="email" maxLength="200" placeholder="you@company.com" spellCheck="false" id="email" required="" size="15" enterKeyHint="send" aria-describedby="e-email" name="email"/><span class="tail">.</span><span class="sr-only" id="e-email"></span></span></p><input class="hp" tabindex="-1" autoComplete="off" aria-hidden="true" name="website"/><div class="row"><p class="fine" dir="auto">The owner reads every offer and replies by email. Payment through Escrow.com.</p><p class="tag" id="offer-error-amount">Offers start at €1,000. Raise yours to send it</p><p class="tag" id="offer-error-name">Add your name</p><p class="tag" id="offer-error-email">Add an email we can reply to</p><p class="tag" id="offer-error-check">Offers need JavaScript for the spam check. Turn it on and send again</p><p class="tag" id="offer-error-rate">Too many offers from here. Try again later</p><p class="tag" id="offer-error-failed">That didn&#x27;t go through. Try again in a minute</p><p class="tag" id="e-form" role="alert"></p><div class="cf-turnstile"></div><button class="send" type="submit"><span class="send-text" data-alt="Sending…"><span>Send offer</span></span><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0-4-4m4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><span class="sr-only" role="status"></span><noscript><p class="nojs" dir="auto">Offers need JavaScript for the spam check. <!-- -->Turn it on and reload this page to send yours.</p></noscript></div></form><div class="sent" id="offer-sent"><h2>Thanks. Your offer is with the owner.</h2><p>Next, the owner reads it. Any reply goes to the email you gave.</p></div><div class="sent" hidden="" tabindex="-1"></div></div></main></body></html>"
`;
