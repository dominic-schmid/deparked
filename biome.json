{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!apps/install/dist",
      "!apps/install/public/assets",
      "!apps/sites/public/catalog",
      "!**/*.generated.ts",
      "!scripts/hooks",
      "!**/*.md",
      "!**/routeTree.gen.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": { "enabled": true },
  "overrides": [
    {
      "includes": ["packages/ui/src/components/ui/**", "packages/ui/src/components/ruixen/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off",
            "noStaticElementInteractions": "off",
            "noSvgWithoutTitle": "off"
          },
          "suspicious": { "noArrayIndexKey": "off", "noDoubleEquals": "off" }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
